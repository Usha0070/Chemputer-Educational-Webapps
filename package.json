{
  "name": "chemputer-educational-webapps",
  "private": true,
  "version": "3.0.0",
  "description": "Chemputer: Bangla chemistry simulations for SSC students (NCTB Class 9–10).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,astro,css}\" \"tests/**/*.ts\" \"*.{mjs,ts,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css}\" \"tests/**/*.ts\" \"*.{mjs,ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "new:sim": "node scripts/new-sim.mjs",
    "legacy": "node scripts/legacy.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

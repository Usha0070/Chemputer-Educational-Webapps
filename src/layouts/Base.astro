---
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import JsonLd from '@/components/JsonLd.astro';
import Sidebar from '@/components/Sidebar.astro';
import { ogImageUrl } from '@/lib/seo';
import { SITE } from '@/lib/site';
// Fonts are deliberately not preloaded: measured on a throttled phone, preloading the Bangla font made the first
// paint later (LCP 2.1 s → 2.8 s) and added a 1.4 s main-thread task while the whole page was laid out in it.

interface Props {
  /** Page title; the brand is appended (" – Chemputer Studio") unless `fullTitle` is given. */
  title: string;
  fullTitle?: string;
  description?: string;
  /** Share image key: public/og/<key>.jpg (made by `npm run og`). */
  ogImage?: string;
  ogAlt?: string;
  /** schema.org structured data for this page. */
  jsonLd?: object | object[];
  noindex?: boolean;
  /** data-* attributes for <body> (simulation pages record progress from these) */
  bodyData?: Record<string, string>;
}

const { title, description = SITE.description, ogImage = 'home', ogAlt, jsonLd, noindex = false, bodyData = {} } = Astro.props;
// The brand goes on short titles only: Google shows about 60 characters, cuts the rest, and already shows the site
// name (from the WebSite structured data) above each result.
const TITLE_MAX = 70;
const branded = `${title} – ${SITE.brand}`;
const fullTitle = Astro.props.fullTitle ?? (branded.length <= TITLE_MAX ? branded : title);
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = ogImageUrl(ogImage);
const imageAlt = ogAlt ?? `${title}: ${SITE.brand}`;
const bodyAttrs = Object.fromEntries(Object.entries(bodyData).map(([k, v]) => [`data-${k}`, v]));
// Vercel Web Analytics (cookieless page views; switched on in the Vercel dashboard). Only in Vercel builds, so local and
// CI builds never request the script.
const analytics = process.env.VERCEL === '1';
// Simulation pages: the sidebar starts as a slim rail and the 3D background is dimmed, so the experiment comes first.
const isSim = 'sim-url' in bodyData;
---

<!doctype html>
<html
  lang="bn"
  data-theme="dark"
  data-page={isSim ? 'sim' : 'page'}
  data-sidebar={isSim ? 'rail' : 'open'}
  data-bg={isSim ? 'dim' : 'full'}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.authorEn} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#050101" />
    <meta name="color-scheme" content="dark light" />
    {noindex && <meta name="robots" content="noindex" />}
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <JsonLd data={jsonLd} />}
    {analytics && (
      <>
        <script is:inline>
          window.va =
            window.va ||
            function (...args) {
              (window.vaq = window.vaq || []).push(args);
            };
        </script>
        <script is:inline defer src="/_vercel/insights/script.js" />
      </>
    )}
    <script is:inline>
      // Apply the saved theme and sidebar width before first paint (dark + full sidebar are the defaults).
      try {
        const h = document.documentElement;
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') h.dataset.theme = t;
        if (t === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#fbf6f3');
        const sb = localStorage.getItem(h.dataset.page === 'sim' ? 'chemputer:sidebar:sim' : 'chemputer:sidebar');
        if (sb === 'rail' || sb === 'open') h.dataset.sidebar = sb;
      } catch {
        /* storage blocked: keep the defaults */
      }
    </script>
  </head>
  <body {...bodyAttrs}>
    <a
      href="#main"
      class="sr-only z-[200] rounded-lg bg-brand px-4 py-2 font-semibold text-on-brand focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      মূল অংশে যাও
    </a>
    <canvas class="bg3d" data-bg3d aria-hidden="true"></canvas>
    <Header />
    <div class="flex flex-1">
      <Sidebar />
      <div class="flex min-w-0 flex-1 flex-col">
        <main id="main" class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import '@/scripts/theme';
      import '@/scripts/progress';
      import '@/scripts/sound';
      import '@/scripts/bg3d';
    </script>
  </body>
</html>

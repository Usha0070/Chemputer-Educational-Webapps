---
import SimPage from '@/components/SimPage.astro';
import { getSims, type Sim } from '@/lib/content';

export async function getStaticPaths() {
  const sims = await getSims();
  // Sims with a custom `path` (e.g. /periodic-table/) get their own route file.
  return sims.filter((sim) => !sim.data.path).map((sim) => ({ params: { chapter: sim.data.chapter.id, sim: sim.id }, props: { sim } }));
}

interface Props {
  sim: Sim;
}
const { sim } = Astro.props;
---

<SimPage sim={sim} />

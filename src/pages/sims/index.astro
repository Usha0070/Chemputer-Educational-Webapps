---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SimCard from '@/components/SimCard.astro';
import Base from '@/layouts/Base.astro';
import { bn } from '@/chem/format';
import { SIM_TYPES } from '@/content.config';
import { TYPE_LABEL, getChapters, getSims, simUrl, simsIn } from '@/lib/content';
import { collectionGraph, ogKey } from '@/lib/seo';

const chapters = await getChapters();
const sims = await getSims();
const chapterOf = new Map(chapters.map((c) => [c.id, c]));
const withSims = chapters.filter((c) => simsIn(c, sims).length > 0);
const types = SIM_TYPES.filter((t) => sims.some((s) => s.data.type === t));
---

<Base
  title="সব রসায়ন সিমুলেশন ও অ্যানিমেশন | All Chemistry Simulations, Animations and Virtual Labs"
  description="Chemputer Studio-এর সব রসায়ন সিমুলেশন, অ্যানিমেশন ও ভার্চুয়াল ল্যাব: অধ্যায় ও ধরন অনুযায়ী খুঁজে নাও। Free chemistry simulations for SSC (Class 9–10) in Bangla."
  ogImage={ogKey.sims}
  jsonLd={collectionGraph(
    'সব রসায়ন সিমুলেশন (All chemistry simulations)',
    '/sims/',
    sims.map((s) => ({ name: `${s.data.title} (${s.data.titleEn})`, url: simUrl(s) })),
  )}
>
  <div class="container-page pt-8 sm:pt-12">
    <Breadcrumbs items={[{ label: 'হোম', href: '/' }, { label: 'সব সিমুলেশন' }]} />
    <p class="brand-bar label-en text-[10px]">All simulations</p>
    <h1 class="mt-4 text-3xl font-bold sm:text-5xl">সব রসায়ন সিমুলেশন</h1>
    <p lang="en" class="mt-2 text-sm font-medium text-muted">
      All chemistry simulations, animations and virtual labs for SSC (Class 9–10).
    </p>
    <p class="mt-3 max-w-2xl text-muted">মোট {bn(sims.length)}টি। অধ্যায় বা ধরন বেছে নিয়ে তালিকা ছোট করো।</p>

    <div class="panel panel-pad mt-6 space-y-4" data-filters>
      <div>
        <p class="label mb-2">ক্লাস</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="chip" aria-pressed="true" disabled>
            নবম-দশম (SSC)
          </button>
        </div>
      </div>
      <div>
        <p class="label mb-2">অধ্যায়</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="অধ্যায় অনুযায়ী ছাঁকো">
          <button type="button" class="chip" data-filter-chapter="all" aria-pressed="true">
            সব
          </button>
          {withSims.map((c) => (
            <button type="button" class="chip" data-filter-chapter={c.id} aria-pressed="false">
              অধ্যায় {bn(c.data.number)} · {c.data.titleBn}
            </button>
          ))}
        </div>
      </div>
      <div>
        <p class="label mb-2">ধরন</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="ধরন অনুযায়ী ছাঁকো">
          <button type="button" class="chip" data-filter-type="all" aria-pressed="true">
            সব
          </button>
          {types.map((t) => (
            <button type="button" class="chip" data-filter-type={t} aria-pressed="false">
              {TYPE_LABEL[t]}
            </button>
          ))}
        </div>
      </div>
    </div>

    <p class="mt-5 text-sm text-muted" aria-live="polite" data-filter-count>
      {bn(sims.length)}টি সিমুলেশন দেখানো হচ্ছে
    </p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3" data-sim-list>
      {sims.map((sim) => (
        <SimCard sim={sim} chapter={chapterOf.get(sim.data.chapter.id)!} />
      ))}
    </div>
    <p class="mt-6 hidden text-center text-muted" data-filter-empty>
      এই শর্তে কোনো সিমুলেশন নেই।
    </p>
  </div>
</Base>

<script>
  import { bn } from '@/chem/format';

  const state = { chapter: 'all', type: 'all' };
  const cards = [...document.querySelectorAll<HTMLElement>('[data-sim-list] [data-sim-card]')];
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  function update() {
    let shown = 0;
    for (const card of cards) {
      const ok =
        (state.chapter === 'all' || card.dataset.chapter === state.chapter) && (state.type === 'all' || card.dataset.type === state.type);
      card.hidden = !ok;
      if (ok) shown++;
    }
    if (count) count.textContent = `${bn(shown)}টি সিমুলেশন দেখানো হচ্ছে`;
    empty?.classList.toggle('hidden', shown > 0);
  }

  for (const key of ['chapter', 'type'] as const) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(`[data-filter-${key}]`)];
    for (const b of buttons) {
      b.addEventListener('click', () => {
        state[key] = b.getAttribute(`data-filter-${key}`) ?? 'all';
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === b));
        update();
      });
    }
  }
</script>

---
// Share-image templates (1200×630), one per page. Built only when OG_CARDS=1 (by `npm run og`, which screenshots
// them into public/og/*.jpg with a real browser, so Bangla conjuncts render correctly). Normal builds skip them.
import '@/styles/global.css';
import BrandMark from '@/components/BrandMark.astro';
import Icon from '@/components/Icon.astro';
import MolecularMotif from '@/components/MolecularMotif.astro';
import { bn } from '@/chem/format';
import { TYPE_LABEL, chapterHue, getChapters, getSims, simsIn } from '@/lib/content';
import { ogKey } from '@/lib/seo';
import { SITE } from '@/lib/site';
import type { IconName } from '@/ui/icons';

interface Card {
  key: string;
  kicker: string;
  title: string;
  sub: string;
  chip: string;
  icon: IconName;
  hue: string;
}

export async function getStaticPaths() {
  if (process.env.OG_CARDS !== '1') return [];
  const [chapters, sims] = await Promise.all([getChapters(), getSims()]);
  const pad = (n: number) => String(n).padStart(2, '0');
  const EN: Record<string, string> = {
    animation: 'Animation',
    simulation: 'Simulation',
    lab: 'Virtual lab',
    solver: 'Step-by-step solver',
    reference: 'Interactive',
  };
  const cards: Card[] = [
    {
      key: ogKey.home,
      kicker: 'SSC · Class 9–10 Chemistry',
      title: 'রসায়ন চোখে দেখে শেখো',
      sub: 'Chemistry simulations & animations in Bangla',
      chip: `${bn(sims.length)}টি সিমুলেশন · ${bn(chapters.length)}টি অধ্যায়`,
      icon: 'atom',
      hue: 'var(--gold)',
    },
    {
      key: ogKey.ssc,
      kicker: 'SSC · Class 9–10 · NCTB',
      title: 'নবম-দশম শ্রেণির রসায়ন',
      sub: 'SSC Chemistry: all 12 chapters',
      chip: `${bn(chapters.length)}টি অধ্যায় · ${bn(sims.length)}টি সিমুলেশন`,
      icon: 'book',
      hue: 'var(--gold)',
    },
    {
      key: ogKey.sims,
      kicker: 'All simulations',
      title: 'সব রসায়ন সিমুলেশন',
      sub: 'Simulations, animations & virtual labs',
      chip: `${bn(sims.length)}টি সিমুলেশন`,
      icon: 'grid',
      hue: 'var(--gold)',
    },
    ...chapters.map((c) => {
      const list = simsIn(c, sims);
      return {
        key: ogKey.chapter(c),
        kicker: `SSC Chemistry · Chapter ${pad(c.data.number)}`,
        title: `অধ্যায় ${bn(c.data.number)}: ${c.data.titleBn}`,
        sub: c.data.titleEn,
        chip: list.length ? `${bn(list.length)}টি সিমুলেশন` : 'শীঘ্রই আসছে',
        icon: list[0]?.data.icon ?? 'book',
        hue: chapterHue(c),
      };
    }),
    ...sims.map((s) => {
      const c = chapters.find((x) => x.id === s.data.chapter.id)!;
      return {
        key: ogKey.sim(s),
        kicker: `SSC Chemistry · Chapter ${pad(c.data.number)}`,
        title: s.data.title,
        sub: s.data.titleEn,
        chip: `${TYPE_LABEL[s.data.type]} · ${EN[s.data.type]}`,
        icon: s.data.icon,
        hue: chapterHue(c),
      };
    }),
  ];
  return cards.map((card) => ({ params: { key: card.key }, props: { card } }));
}

const { card } = Astro.props as { card: Card };
const size = card.title.length <= 12 ? 96 : card.title.length <= 16 ? 84 : card.title.length <= 22 ? 70 : card.title.length <= 32 ? 62 : 54;
const host = new URL(SITE.url).host;
---

<!doctype html>
<html lang="bn" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{card.title}</title>
  </head>
  <body>
    <div class="card" style={`--c: ${card.hue}`}>
      <MolecularMotif class="motif" />
      <div class="glow" aria-hidden="true"></div>
      <div class="left">
        <div class="brand">
          <BrandMark class="h-14 w-14" />
          <span class="wordmark text-[34px] tracking-[0.08em]">CHEMPUTER</span>
          <span class="label-en studio">Studio</span>
        </div>
        <p class="brand-bar label-en kicker">{card.kicker}</p>
        <h1 class="title" style={`font-size: ${size}px`}>
          {card.title}
        </h1>
        <p class="sub" lang="en">
          {card.sub}
        </p>
        <p class="chip">{card.chip}</p>
      </div>
      <div class="tile">
        <Icon name={card.icon} class="h-[150px] w-[150px]" />
      </div>
      <p class="foot label-en">Chemistry made simple · {host}</p>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #050101 !important;
    display: block !important;
  }
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background:
      radial-gradient(700px 520px at 100% 100%, #3c0606 0%, transparent 70%),
      radial-gradient(600px 400px at 85% 0%, color-mix(in oklab, var(--c) 18%, transparent) 0%, transparent 70%),
      linear-gradient(100deg, #050101 40%, #1e0606 100%);
    font-family: 'Hind Siliguri', sans-serif;
    color: #f6f6f6;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 12px;
    background: linear-gradient(180deg, var(--c), #ba0000);
  }
  .motif {
    position: absolute;
    right: -40px;
    top: 0;
    width: 62%;
    height: 100%;
    opacity: 0.55;
  }
  .glow {
    position: absolute;
    right: 120px;
    top: 150px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--c) 35%, transparent), transparent);
  }
  .left {
    position: absolute;
    left: 72px;
    top: 56px;
    width: 660px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .studio {
    margin-top: 6px;
    font-size: 15px;
    color: #ae9895;
  }
  .kicker {
    margin-top: 44px;
    font-size: 16px;
    padding: 6px 14px;
  }
  .title {
    margin: 22px 0 0;
    font-weight: 700;
    line-height: 1.22;
    color: #fcde56;
  }
  .sub {
    margin: 14px 0 0;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.3;
    color: #f6f6f6;
  }
  .chip {
    display: inline-block;
    margin-top: 26px;
    padding: 8px 20px;
    border-radius: 999px;
    font-size: 24px;
    font-weight: 600;
    color: var(--c);
    box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--c) 60%, transparent);
  }
  .tile {
    position: absolute;
    right: 150px;
    top: 200px;
    display: grid;
    width: 280px;
    height: 280px;
    place-items: center;
    border-radius: 56px;
    color: var(--c);
    background: color-mix(in oklab, var(--c) 14%, #0f0606);
    box-shadow:
      inset 0 0 0 3px color-mix(in oklab, var(--c) 55%, transparent),
      0 30px 80px -30px color-mix(in oklab, var(--c) 70%, transparent);
  }
  .foot {
    position: absolute;
    left: 72px;
    bottom: 40px;
    margin: 0;
    font-size: 15px;
    color: #ae9895;
  }
</style>

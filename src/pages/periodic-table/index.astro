---
// Site-wide reference: the full periodic table (content entry src/content/sims/periodic-table.mdx).
import SimPage from '@/components/SimPage.astro';
import { getSims } from '@/lib/content';

const sim = (await getSims()).find((s) => s.data.path === '/periodic-table/');
if (!sim) throw new Error('periodic-table.mdx with path /periodic-table/ is missing');
---

<SimPage sim={sim} />

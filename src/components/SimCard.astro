---
import { TYPE_LABEL, chapterHue, chapterLabel, simUrl, type Chapter, type Sim } from '@/lib/content';
import Icon from './Icon.astro';

interface Props {
  sim: Sim;
  chapter: Chapter;
  showChapter?: boolean;
}
const { sim, chapter, showChapter = true } = Astro.props;
const url = simUrl(sim);
// Each card glows in its chapter's hue plus a second warm brand hue that differs from card to card, so even cards
// of the same chapter get their own shade. A per-card delay keeps neighbouring glows out of step.
const WARM = [3, 4, 6, 7, 1, 8];
const second = WARM[(chapter.data.number + sim.data.order) % WARM.length];
const delay = -((chapter.data.number * 7 + sim.data.order * 5) % 18);
---

<a
  href={url}
  data-sim-card={url}
  data-chapter={chapter.id}
  data-type={sim.data.type}
  class="sim-card tint group panel flex h-full flex-col p-5 transition duration-200 hover:-translate-y-1 sm:p-6"
  style={`--c: ${chapterHue(chapter)}; --tint-b-colour: var(--ch-${second}); --tint-delay: ${delay}s`}
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <span class="icon-tile tint-tile h-12 w-12">
      <Icon name={sim.data.icon} class="h-6 w-6" />
    </span>
    <span class="rounded-full border border-line bg-raised/80 px-2.5 py-0.5 text-[11px] font-semibold text-muted">
      {TYPE_LABEL[sim.data.type]}
    </span>
  </div>
  {showChapter && (
    <p class="tint-text mb-1 text-xs font-semibold">
      {chapterLabel(chapter)} · {chapter.data.titleBn}
    </p>
  )}
  <h3 class="mb-2 text-lg leading-snug font-bold text-ink">{sim.data.title}</h3>
  <p class="mb-5 flex-1 text-sm leading-relaxed text-muted">{sim.data.description}</p>
  <span class="flex items-center justify-between gap-2">
    <span class="tint-text inline-flex items-center gap-1.5 text-sm font-semibold">
      খুলে দেখো <Icon name="arrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
    <span class="seen-badge hidden items-center gap-1 rounded-full bg-raised px-2 py-0.5 text-[11px] font-semibold text-block-p">
      <Icon name="check" class="h-3.5 w-3.5" /> দেখা হয়েছে
    </span>
  </span>
</a>

<style>
  .sim-card[data-seen='true'] .seen-badge {
    display: inline-flex;
  }
</style>

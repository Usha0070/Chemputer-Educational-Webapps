---
import { TYPE_LABEL, chapterLabel, simUrl, type Chapter, type Sim } from '@/lib/content';
import Icon from './Icon.astro';

interface Props {
  sim: Sim;
  chapter: Chapter;
  showChapter?: boolean;
}
const { sim, chapter, showChapter = true } = Astro.props;
const url = simUrl(sim);
---

<a
  href={url}
  data-sim-card={url}
  data-chapter={chapter.id}
  data-type={sim.data.type}
  class="sim-card group panel relative flex flex-col p-5 transition duration-200 hover:-translate-y-1 hover:border-brand/70 sm:p-6"
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <span class="icon-tile h-12 w-12 bg-brand/15 text-gold ring-brand/40">
      <Icon name={sim.data.icon} class="h-6 w-6" />
    </span>
    <span class="rounded-full border border-line bg-raised/80 px-2.5 py-0.5 text-[11px] font-semibold text-muted">
      {TYPE_LABEL[sim.data.type]}
    </span>
  </div>
  {showChapter && (
    <p class="mb-1 text-xs font-semibold text-brand-ink">
      {chapterLabel(chapter)} · {chapter.data.titleBn}
    </p>
  )}
  <h3 class="mb-2 text-lg leading-snug font-bold text-ink">{sim.data.title}</h3>
  <p class="mb-5 flex-1 text-sm leading-relaxed text-muted">{sim.data.description}</p>
  <span class="flex items-center justify-between gap-2">
    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-gold">
      খুলে দেখো <Icon name="arrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
    <span class="seen-badge hidden items-center gap-1 rounded-full bg-raised px-2 py-0.5 text-[11px] font-semibold text-block-p">
      <Icon name="check" class="h-3.5 w-3.5" /> দেখা হয়েছে
    </span>
  </span>
</a>

<style>
  .sim-card[data-seen='true'] .seen-badge {
    display: inline-flex;
  }
</style>

---
import { bn, bnPad } from '@/chem/format';
import { chapterUrl, pagesLabel, type Chapter } from '@/lib/content';
import Icon from './Icon.astro';

interface Props {
  chapter: Chapter;
  simCount: number;
}
const { chapter, simCount } = Astro.props;
---

<a
  href={chapterUrl(chapter)}
  class="group panel relative flex flex-col overflow-hidden p-5 transition duration-200 hover:-translate-y-1 hover:border-brand/70"
>
  <span class="absolute -top-3 -right-1 font-display text-6xl font-extrabold text-brand/15 select-none" aria-hidden="true">
    {String(chapter.data.number).padStart(2, '0')}
  </span>
  <p class="label-en text-[10px] text-gold/90">Chapter {String(chapter.data.number).padStart(2, '0')}</p>
  <h3 class="mt-1 text-lg leading-snug font-bold text-ink">
    <span class="text-muted">অধ্যায় {bnPad(chapter.data.number)} ·</span>
    {chapter.data.titleBn}
  </h3>
  <p class="mt-1 text-xs text-muted">
    {chapter.data.titleEn} · বই: {pagesLabel(chapter.data.pages)}
  </p>
  <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{chapter.data.summary}</p>
  <div class="mt-4 flex items-center justify-between">
    {simCount > 0 ? (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/15 px-2.5 py-1 text-xs font-semibold text-gold">
        <Icon name="atom" class="h-3.5 w-3.5" />
        {bn(simCount)}টি সিমুলেশন
      </span>
    ) : (
      <span class="rounded-full border border-line px-2.5 py-1 text-xs font-semibold text-muted">শীঘ্রই আসছে</span>
    )}
    <Icon name="arrowRight" class="h-4 w-4 text-gold transition-transform group-hover:translate-x-1" />
  </div>
</a>
